/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# Local environment and credentials
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/.npmrc
!**/.npmrc.example
**/.netrc
**/.git-credentials
**/.aws/credentials
**/application_default_credentials.json
**/secrets/
**/.secrets/
**/credentials.json
**/service-account*.json
/src/environments/environment.local.ts
/src/environments/environment.*.local.ts

# Private keys and certificates
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.jceks
*.keystore
*.truststore
*.ppk
id_rsa
id_dsa
id_ecdsa
id_ed25519

